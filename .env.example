# Database Configuration (AWS PostgreSQL RDS / Cloud SQL / Local)
# Option 1: Full Connection String
# DATABASE_URL=postgresql://username:password@your-aws-rds-host.rds.amazonaws.com:5432/dbname?sslmode=require

# Option 2: Individual Parameters
# SQL_HOST=your-aws-rds-host.rds.amazonaws.com
# SQL_PORT=5432
# SQL_USER=postgres
# SQL_PASSWORD=your_password
# SQL_DB_NAME=syndicate_erp
# SQL_SSL=true

# Gemini API Key (if server-side Gemini features are enabled)
GEMINI_API_KEY=

# Firebase Client Configuration (managed via firebase-applet-config.json)
FIREBASE_API_KEY=
